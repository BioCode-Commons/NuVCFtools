#!/usr/bin/env perl

use strict;
use warnings;
use Carp;
use NuOrderedWorkers;
use Vcf;

my $opts = parse_params();
convert_to_tab($opts);

exit;

#--------------------------------

sub error
{
    my (@msg) = @_;
    if ( scalar @msg )
    {
        croak @msg;
    }
    die
        "Usage: vcf-to-tab [OPTIONS] < in.vcf > out.tab\n",
        "Options:\n",
        "       --workers N                  Ordered worker processes (default 1).\n",
        "       --worker-batch-bytes N       Input bytes per batch (default 4194304).\n",
        "   -h, -?, --help                   This help message.\n",
        "   -i, --iupac                      Use one-letter IUPAC codes\n",
        "Notes:\n",
        "   Please use `bcftools query` instead, this script will not be supported in future.\n",
        "\n";
}


sub parse_params
{
    my $opts = { iupac=>0 };
    while (my $arg=shift(@ARGV))
    {
        if (NuOrderedWorkers::take_option($opts,$arg,\@ARGV)) { next; }
        if ( $arg eq '-?' || $arg eq '-h' || $arg eq '--help' ) { error(); }
        if ( $arg eq '-i' || $arg eq '--iupac' ) { $$opts{iupac}=1; next; }
        error("Unknown parameter \"$arg\". Run -h for help.\n");
    }

    if ( $$opts{iupac} )
    {
        $$opts{iupac} = 
        {
            'GG' => 'G',
            'CC' => 'C',
            'TT' => 'T',
            'AA' => 'A',

            'GT' => 'K',
            'TG' => 'K',
            'AC' => 'M',
            'CA' => 'M',
            'CG' => 'S',
            'GC' => 'S',
            'AG' => 'R',
            'GA' => 'R',
            'AT' => 'W',
            'TA' => 'W',
            'CT' => 'Y',
            'TC' => 'Y',

            '..' => '.',
        };
    }

    return $opts;
}


sub convert_to_tab
{
    my ($opts) = @_;

    my $iupac;
    if ( $$opts{iupac} ) { $iupac=$$opts{iupac}; }

    my $vcf = Vcf->new(fh=>\*STDIN);
    $vcf->parse_header();


    my $sample_order;
    NuOrderedWorkers::run(
        workers=>$$opts{workers} || 1,
        next=>NuOrderedWorkers::prepared_line_batches(sub { $vcf->next_line() }, sub { $vcf->prepare_data_columns($_[0],($$opts{workers} || 1)>1) }, $$opts{worker_batch_bytes} || 4194304),
        work=>sub {
        my ($batch)=@_;
        for my $item (@$batch) {
        my $prepared=NuOrderedWorkers::take_prepared_value($item);
        next unless defined $prepared;
        my $x=$vcf->next_prepared_hash($prepared,1,0,1);
        # Header columns define the possible sample names. Empty sample fields
        # can omit entries on any record, so retain the per-record existence check.
        if (!defined $sample_order) {
            my %names = map { $_ => 1 } @{$vcf->{columns}}[9..$#{$vcf->{columns}}];
            $sample_order = [sort keys %names];
        }
        if ( $$item[0]==0 )
        {
            print "#CHROM\tPOS\tREF";
            for my $col (grep { exists $$x{gtypes}{$_} } @$sample_order)
            {
                print "\t$col";
            }
            print "\n";

        }

        my %rendered; # Exact GT strings, scoped to this record (REF/ALT and mode are fixed).
        print "$$x{CHROM}\t$$x{POS}\t$$x{REF}";
        for my $col (grep { exists $$x{gtypes}{$_} } @$sample_order)
        {
            my $raw_gt = $$x{gtypes}{$col}{GT};
            if ( defined $raw_gt && exists $rendered{$raw_gt} )
            {
                print "\t".$rendered{$raw_gt};
                next;
            }
            my ($al1,$sep,$al2) = exists($$x{gtypes}{$col}{GT}) ? $vcf->parse_alleles($x,$col) : ('.','/','.');
            my $gt = $al1.'/'.$al2;
            if ( $iupac )
            {
                $gt = $al1.$al2;
                if ( !exists($$iupac{$gt}) ) { error(qq[Unknown IUPAC code for "$al1$sep$al2" .. $$x{CHROM}:$$x{POS} $col\n]); }
                $gt = $$iupac{$gt};
            }
            # Undefined alleles retain the original per-sample diagnostics.
            if ( defined $raw_gt && defined $al1 && defined $al2 ) { $rendered{$raw_gt} = $gt; }
            print "\t".$gt;
        }
        print "\n";
        }
        return;
    });
}

