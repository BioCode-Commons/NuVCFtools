#!/usr/bin/env perl

use strict;
use warnings;
use Carp;
use NuOrderedWorkers;
use Vcf;

my $opts = parse_params();
fill_an_ac($opts);

exit;

#--------------------------------

sub error
{
    my (@msg) = @_;
    if ( scalar @msg ) { confess @msg; }
    die
        "Usage: fill-an-ac [OPTIONS] < in.vcf >out.vcf\n",
        "Options:\n",
        "       --workers N                  Ordered worker processes (default 1).\n",
        "       --worker-batch-bytes N       Input bytes per batch (default 4194304).\n",
        "   -h, -?, --help                      This help message.\n",
        "\n";
}


sub parse_params
{
    my $opts = {};
    while (my $arg=shift(@ARGV))
    {
        if (NuOrderedWorkers::take_option($opts,$arg,\@ARGV)) { next; }
        if ( -e $arg ) { $$opts{file} = $arg; next }
        if ( $arg eq '-?' || $arg eq '-h' || $arg eq '--help' ) { error(); }
        error("Unknown parameter \"$arg\". Run -h for help.\n");
    }
    return $opts;
}


sub fill_an_ac
{
    my ($opts) = @_;
    my $file=$$opts{file};

    my $vcf = $file ? Vcf->new(file=>$file) : Vcf->new(fh=>\*STDIN);
    $vcf->parse_header();
    $vcf->add_header_line({key=>'INFO',ID=>'AC',Number=>-1,Type=>'Integer',Description=>'Allele count in genotypes'});
    $vcf->add_header_line({key=>'INFO',ID=>'AN',Number=>1,Type=>'Integer',Description=>'Total number of alleles in called genotypes'});
    print $vcf->format_header();
    $vcf->recalc_ac_an(2);

    NuOrderedWorkers::run(
        workers=>$$opts{workers} || 1,
        next=>NuOrderedWorkers::prepared_line_batches(sub { $vcf->next_line() }, sub { $vcf->prepare_data_columns($_[0],($$opts{workers} || 1)>1) }, $$opts{worker_batch_bytes} || 4194304),
        work=>sub {
        my ($batch)=@_;
        for my $item (@$batch) {
        my $prepared=NuOrderedWorkers::take_prepared_value($item);
        next unless defined $prepared;
        my $rec=$vcf->next_prepared_hash($prepared,0);
        print $vcf->format_line($rec);
        }
        return;
    });
}

