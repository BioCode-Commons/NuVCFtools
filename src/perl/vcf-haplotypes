            or die "Cannot read tabix header from $$self{file}: $!";
        my @lines = <TABIX>;
        close TABIX;
        return \@lines;
    }





package Record;

# Sparse mode needs at least 16,384 coordinates and 128 slots per occupied bucket.
# Keep the logical array extent: splice offsets depend on it even without events.
sub _gff_coordinate {
    my ($value) = @_;
    return defined($value) && !ref($value) && $value =~ /\A[0-9]{1,10}\z/;
}

sub _gff_existing {
    my ($self) = @_;
    return unless $gff_context{enabled};
    my $state = $gff_context{records}{$self};
    return $state && !$$state{disabled} ? $state : undef;
}

sub _gff_state {
    my ($self, $needed) = @_;
    return unless $gff_context{enabled};
    my $state = $gff_context{records}{$self};
    return $$state{disabled} ? undef : $state if $state;
    return unless ref($self) eq 'Record' && _gff_coordinate($needed) && $needed>=16384;
    my $features = $$self{features};
    return unless ref($features) eq 'ARRAY' && !defined(tied(@$features));
    my @occupied = grep { defined $$features[$_] } 0..$#$features;
    # Preserve legacy malformed buckets and their original dereference errors.
    if ( grep { ref($$features[$_]) ne 'ARRAY' } @occupied ) {
        $gff_context{records}{$self} = {disabled=>1};
        return;
    }
    my $length = max(scalar(@$features), $needed);
    if ( @occupied * 128 > $length ) {
        $gff_context{records}{$self} = {disabled=>1};
        return;
    }
    # The caller's records array owns each Record; keeping it here would delay file closure.
    $state = {length=>$length, slots=>{}};
    for my $pos (@occupied) { $$state{slots}{$pos} = $$features[$pos]; }
    @$features = ();
    $gff_context{records}{$self} = $state;
    return $state;
}

sub _gff_materialize {
    my ($self) = @_;
    return unless $gff_context{enabled};
    my $state = $gff_context{records}{$self};
    return if $state && $$state{disabled};
    # Unsafe input must also prevent activation by a later, wider feature.
    if ( !$state ) {
        $gff_context{records}{$self} = {disabled=>1};
        return;
    }
    my $features = $$self{features};
    $#$features = $$state{length} - 1;
    for my $pos (keys %{$$state{slots}}) { $$features[$pos] = delete $$state{slots}{$pos}; }
    $gff_context{records}{$self} = {disabled=>1};
}

sub _gff_drop_prefix {
    my ($state, $length) = @_;
    return unless $length;
    # Ascending moves cannot overwrite a position still awaiting its move.
    for my $pos (sort { $a<=>$b } keys %{$$state{slots}}) {
        my $bucket = delete $$state{slots}{$pos};
        $$state{slots}{$pos-$length} = $bucket if $pos >= $length;
    }
    $$state{length} = max(0, $$state{length} - $length);
}

sub _gff_delete {
    my ($self, $state, $start, $length) = @_;
    my $end = $start + $length - 1;
    my %overlapping;
    for my $pos (sort { $a<=>$b } grep { $_ >= $start && $_ <= $end } keys %{$$state{slots}}) {
        while ( my $event = shift @{$$state{slots}{$pos}} ) {
            my $first = $overlapping{$$event{feature}};
            if ( defined $first ) {
                $self->remove_feature($end + 1, $first);
                $self->print_warning('Feature deleted: ',
                    "$$first{feature}{feature} ",
                    "($$first{feature}{start}-$$first{feature}{end})",
                    "$$first{feature}{rest}\n");
            }
            elsif ( $$event{type} eq 's' ) {
                push @{$$state{slots}{$end+1}}, $event;
                $$state{length} = max($$state{length}, $end + 2);
                $overlapping{$$event{feature}} = $event;
            }
            elsif ( $$event{type} eq 'e' ) { push @{$$state{slots}{$start-1}}, $event; }
        }
        delete $$state{slots}{$pos};
    }
    for my $pos (sort { $a<=>$b } grep { $_>$end } keys %{$$state{slots}}) {
        $$state{slots}{$pos-$length} = delete $$state{slots}{$pos};
    }
    $$state{length} -= $length;
}
